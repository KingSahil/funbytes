# ==========================================
# FunBytes Environment Configuration
# ==========================================

# Backend Configuration
PORT=4000
NODE_ENV=development
API_URL=http://localhost:4000

# Client Configuration
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
EXPO_PUBLIC_ENABLE_DEMO_FALLBACK=true

# Database (Optional for production scale; default uses robust in-memory/JSON store)
DATABASE_URL="file:./funbytes.db"

# Authentication & Security
AUTH_SECRET="funbytes_super_secret_jwt_key_development_only_12345"
ADMIN_API_KEY="funbytes_admin_secret_key"

# External API Integrations (Optional - RSS & Public Endpoints used by default)
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="FunBytesBot/1.0"

# AI Summarization Service (Optional - built-in extractive & heuristic summary active by default)
GEMINI_API_KEY=""
AI_SUMMARIZER_ENABLED=false

# Cache & Rate Limiting
REDIS_URL=""
CACHE_TTL_SECONDS=300
RATE_LIMIT_MAX_REQUESTS=120
