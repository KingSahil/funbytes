{
  "name": "funbytes-monorepo",
  "version": "1.0.0",
  "description": "FunBytes - Personalized News, Memes & Social Feed App",
  "private": true,
  "workspaces": [
    "packages/*",
    "backend",
    "apps/*"
  ],
  "scripts": {
    "dev:backend": "bun run --cwd backend dev",
    "dev:mobile": "bun run --cwd apps/mobile start",
    "build": "bun run --cwd backend build",
    "test": "bun run --cwd backend test",
    "lint": "bun run --cwd backend lint"
  },
  "keywords": [
    "funbytes",
    "react-native",
    "expo",
    "typescript",
    "news",
    "memes",
    "social-feed"
  ],
  "author": "FunBytes Team",
  "license": "MIT"
}
